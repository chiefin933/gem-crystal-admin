# Gem & Crystal Admin Dashboard — Environment

# ── API Backend ────────────────────────────────────────────────────────────
# Development: leave empty — Vite proxies /api → localhost:4000 automatically
# Production: set to your deployed API URL e.g. https://api.gemandcrystal.co.ke
VITE_API_URL=

# ── POS Terminal URL ───────────────────────────────────────────────────────
# Development: http://localhost:5175
# Production: https://pos.gemandcrystal.co.ke (or wherever POS is deployed)
VITE_POS_URL=http://localhost:5175

# ── Storefront URL (used by the "Open Live Store" sidebar link) ────────────
# Development: http://localhost:5173
# Production: https://shop.gemandcrystal.co.ke
VITE_STOREFRONT_URL=http://localhost:5173
